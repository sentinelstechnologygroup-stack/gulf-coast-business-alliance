{
  "name": "MemberApplication",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Name of the business"
    },
    "contact_name": {
      "type": "string",
      "description": "Owner or contact name"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "business_category": {
      "type": "string"
    },
    "service_area": {
      "type": "string"
    },
    "membership_interest": {
      "type": "string",
      "enum": [
        "basic",
        "verified",
        "featured",
        "growth",
        "category_sponsor",
        "not_sure"
      ]
    },
    "message": {
      "type": "string"
    },
    "source_page": {
      "type": "string",
      "description": "Page where the form was submitted"
    },
    "consent_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "disclosure_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "assigned_category": {
      "type": "string",
      "description": "GCBA-assigned service category"
    },
    "assigned_chair": {
      "type": "string",
      "description": "GCBA category chair assigned"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal GCBA notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "approved",
        "declined"
      ],
      "default": "new"
    }
  },
  "required": [
    "business_name",
    "contact_name",
    "email"
  ]
}